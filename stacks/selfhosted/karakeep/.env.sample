# Karakeep Stack Environment Variables
# Copy to .env and fill in:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not.

########################### SECRETS  (required)
# Generate once and keep them: changing NEXTAUTH_SECRET logs every session out; changing
# MEILI_MASTER_KEY locks Karakeep out of its existing search index (reindex from Admin).
#   openssl rand -base64 36
NEXTAUTH_SECRET=
MEILI_MASTER_KEY=
# Optional - AI tagging. Empty disables it.
OPENAI_API_KEY=

########################### RUNTIME
PUID=568
PGID=568
TZ=Europe/Dublin
DATA_DIR=/data
MEILI_ADDR=http://meilisearch:7700

########################### ROUTING
# Traefik router Host(`pocket.${DOMAINNAME}`); Karakeep's own login, no Authelia chain.
# Needs its own Cloudflare record - see NETWORK.md "Cloudflare DNS records that are not the default".
DOMAINNAME=deercrest.info
NEXTAUTH_URL=https://pocket.${DOMAINNAME}
