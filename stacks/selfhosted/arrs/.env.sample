# Arrs Stack Environment Variables
# Copy to .env and set actual values:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored (**/.env),
# .env.sample is not. Key names taken from the live host .env on 2026-10-23 (quick 261023-afi),
# which is when this sample was first created; the stack had none before.

########################### COMMON
PUID=568
PGID=568
TZ=Europe/Dublin
DOMAINNAME=example.com
APPDATA=/mnt/fast/appdata
MEDIA=/mnt/tank/media
DOWNLOADS=/mnt/tank/downloads

########################### APP API KEYS  (each app: Settings -> General -> API Key)
SONARR_API_KEY=CHANGE_ME
RADARR_API_KEY=CHANGE_ME
LIDARR_API_KEY=CHANGE_ME
READARR_API_KEY=CHANGE_ME
BAZARR_API_KEY=CHANGE_ME
SABNZBD_API_KEY=CHANGE_ME
PROWLARR_API_KEY=CHANGE_ME
GENIUS_API_KEY=CHANGE_ME

########################### TRAEFIK AUTH-BYPASS HEADER VALUES  (mobile apps)
# Generate each with:  openssl rand -hex 32
TRAEFIK_AUTH_BYPASS_KEY=CHANGE_ME
SONARR_AUTH_BYPASS_KEY=CHANGE_ME
RADARR_AUTH_BYPASS_KEY=CHANGE_ME
LIDARR_AUTH_BYPASS_KEY=CHANGE_ME
READARR_AUTH_BYPASS_KEY=CHANGE_ME
BAZARR_AUTH_BYPASS_KEY=CHANGE_ME
SABNZBD_AUTH_BYPASS_KEY=CHANGE_ME
QBITTORRENT_AUTH_BYPASS_KEY=CHANGE_ME

########################### SLSKD / LEGACY
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=CHANGE_ME
# soulbeet's definition was deleted in plan 04-03; the key survives in the host .env only.
SOULBEET_SECRET_KEY=CHANGE_ME

########################### RREADING-GLASSES  (rreading-glasses.yaml - Hardcover metadata for Bookshelf)
# The FULL Authorization header value, including the "Bearer " prefix:
#   hardcover.app -> Settings -> API -> copy token, then  HARDCOVER_AUTH=Bearer <token>
# Unset is tolerated by `docker compose config`, but rreading-glasses cannot serve without it.
HARDCOVER_AUTH=Bearer CHANGE_ME
# Alphanumeric only (it is placed in a Postgres connection string).
# Generate with:  openssl rand -hex 16
RREADING_GLASSES_DB_PASSWORD=CHANGE_ME
