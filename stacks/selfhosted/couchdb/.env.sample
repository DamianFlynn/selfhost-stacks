# CouchDB Stack Environment Variables
# Copy to .env and fill in:  cp .env.sample .env  (README step 4 builds it from Bitwarden instead)
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not.

########################### ADMIN  (required - Bitwarden: neocortex/shared/couchdb-admin)
# CouchDB server admin. Used by the healthcheck, the LiveSync provisioning run and user/db
# creation. LiveSync clients do NOT use it - they use the member user (livesync-damian).
COUCHDB_USER=
COUCHDB_PASSWORD=

########################### RUNTIME
# The image's `couchdb` user. Not the estate's apps:apps (568) - see README "Why 5984".
PUID=5984
PGID=5984
TZ=Europe/Dublin

########################### ROUTING
# Traefik router Host(`couchdb.${DOMAINNAME}`)
DOMAINNAME=deercrest.info
