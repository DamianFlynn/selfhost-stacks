# BookOrbit Stack Environment Variables
# Copy to .env and set actual values:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not.

########################### LOCALE
TZ=Europe/Dublin

########################### DATABASE
POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
# Generate with:  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

########################### APP SECRETS  (required)
# Signs session tokens. Changing it logs every user and device out.
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Encrypts podcast feed URLs. Independent of JWT_SECRET on a fresh install.
# Generate with:  openssl rand -hex 32
PODCAST_ENCRYPTION_KEY=CHANGE_ME

# Required by the one-time POST /api/v1/auth/setup (x-setup-token header).
# Generate with:  openssl rand -hex 32
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME

########################### OPTIONAL
# Only if Authelia OIDC is ever configured (not today): allow an issuer on a private address.
# OIDC_ALLOW_LOCAL_ISSUERS=true
