# FreshRSS Stack Environment Variables
# Copy to .env and fill in:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not. This stack has no secrets in .env: FreshRSS keeps its
# users and API passwords in /config, and the route sits behind chain-authelia@file.

########################### RUNTIME
PUID=568
PGID=568
TZ=Europe/Dublin

########################### ROUTING
# Router host is literal in compose.yaml: Host(`feeds.deercrest.info`) - not freshrss.
DOMAINNAME=deercrest.info
