# Silo — environment template. Copy to .env and fill in.
# .env is gitignored (**/.env). THIS REPO IS PUBLIC: never commit real values.

# ── Postgres (dedicated instance, see compose.yaml for why it is not shared) ──────────
SILO_DB_NAME=silo
SILO_DB_USER=silo
# Generate:  openssl rand -base64 36 | tr -d '\n=+/'
SILO_DB_PASSWORD=

# ── SECRET_KEY ────────────────────────────────────────────────────────────────────────
# MUST be >= 32 characters; the server refuses to start otherwise (minSecretKeyLen).
# Generate:  openssl rand -base64 48 | tr -d '\n'
#
# BACK THIS UP SEPARATELY FROM DATABASE DUMPS. It encrypts integration API keys, S3
# credentials, plugin config secrets and the Tailscale plugin's tsnet node identity —
# Silo's own compose warns "losing it makes encrypted secrets unrecoverable" and the
# docs say to "treat it like a CA private key". A pg_dump alone is NOT a restore.
SILO_SECRET_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────────────
TZ=Europe/Dublin

# ── NOT set here, on purpose ───────────────────────────────────────────────────────────
# POSTGRES_TUNE   — leave unset. Unset == disabled at code level. See compose.yaml.
# REDIS_URL       — optional in `integrated` mode. ai-redis on its own DB index if wanted.
# MEILI*          — Silo reads NO Meilisearch env vars. Search is configured in admin
#                   settings rows (catalog.search.meilisearch.*), set after first boot.
