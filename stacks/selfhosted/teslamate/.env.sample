# TeslaMate Stack Environment Variables
# Copy to .env and set actual values:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not.
#
# NO TESLA CREDENTIALS BELONG IN THIS FILE.
# TeslaMate signs in with unofficial owners-API access/refresh tokens that are
# pasted into the web UI at https://teslamate.deercrest.info and encrypted at
# rest with TESLAMATE_ENCRYPTION_KEY below. They are never read from env.

########################### LOCALE
TZ=Europe/Dublin


########################### CORE SECRETS  (required)

# Symmetric key wrapping the stored Tesla access/refresh tokens in Postgres.
#
# Generate with:
#   openssl rand -hex 32
#
# *** BACK THIS UP ALONGSIDE THE teslamate-db VOLUME ***
# If it is lost or changed, the stored tokens become permanently unreadable and
# the vehicle must be re-authorised by hand. A database restore without the
# matching key produces an unusable credential store.
TESLAMATE_ENCRYPTION_KEY=change_me_openssl_rand_hex_32

# The one Postgres password for this stack. Compose feeds this single value to
# all three places that need it, so they cannot drift apart:
#   POSTGRES_PASSWORD  on database
#   DATABASE_PASS      on teslamate
#   DATABASE_PASS      on grafana
# Changing it after first boot does NOT change the password inside the existing
# database volume - do that with ALTER ROLE first, or start from an empty volume.
#
# Generate with:
#   openssl rand -base64 32
TESLAMATE_DB_PASS=change_me_to_random_password


########################### GRAFANA ADMIN  (required)
# Grafana's own local admin account. Authelia gates the hostname, but this is
# the second lock: without it Grafana runs on the stock admin/admin and any
# Authelia bypass hands over the vehicle's full location history.
#
# Generate with:
#   openssl rand -base64 24
TESLAMATE_GRAFANA_USER=admin
TESLAMATE_GRAFANA_PASS=change_me_to_random_password
