# AirTrail - environment template. Copy to .env and fill in.
# .env is gitignored (**/.env). THIS REPO IS PUBLIC: never commit real values.

# Shared estate values (see other stacks' .env for the canonical pair)
TZ=Europe/Dublin
DOMAINNAME=deercrest.info

# ── Database ──────────────────────────────────────────────────────────────────────────
AIRTRAIL_DB_NAME=airtrail
AIRTRAIL_DB_USER=airtrail

# ⚠️ Upstream requires A-Za-z0-9 ONLY here -- punctuation breaks the DB_URL that embeds it.
# Generate:  openssl rand -base64 36 | tr -dc 'A-Za-z0-9' | head -c 40
#
# ⚠️ This is applied ONLY on the database's very first start. Changing it later gives
# "password authentication failed" and must be fixed with ALTER USER inside the DB -- the
# variable is not re-read. It is interpolated into BOTH POSTGRES_PASSWORD and DB_URL from
# this single value, which is why it is defined once here.
AIRTRAIL_DB_PASSWORD=

# ── NOT set here, on purpose ───────────────────────────────────────────────────────────
# AIRTRAIL_OIDC_SECRET  - only needed if OAUTH_* is uncommented in airtrail.yaml. The
#                         operator chose Traefik forward-auth over OIDC on 2026-09-28, so
#                         OIDC is off and there are two logins (Authelia, then AirTrail).
#                         If enabling: the Authelia client's redirect URI is
#                         https://airtrail.<domain>/login  -- NOT /callback.
# INTEGRATIONS_AERO_DATA_BOX_KEY - optional. The default lookup provider (adsbdb) is free,
#                         keyless, but has NO date search and patchy coverage. AeroDataBox
#                         adds date-based lookup, though only ~12 months of history.
#
# An EMPTY value (KEY=) counts as UNSET to AirTrail, and a bad value in an app-mirrored
# setting makes the server exit with "Invalid app config in .env". Comment out; do not
# leave a bare KEY= behind.
