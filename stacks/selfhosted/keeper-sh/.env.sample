# Keeper.sh Stack Environment Variables
# Copy to .env and set actual values:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values — .env is gitignored,
# .env.sample is not.
#
# Full documentation: ./README.md

########################### SERVICE ACCOUNT
# Repo convention: apps:apps
PUID=568
PGID=568
TZ=Europe/Dublin


########################### CORE SECRETS  (required)
# Generate each with:  openssl rand -base64 32

# Postgres password for the keeper database
POSTGRES_PASSWORD=change_me_to_random_password

# Session signing key for cal-api. Rotating invalidates active sessions.
BETTER_AUTH_SECRET=change_me_to_random_secret

# Symmetric key wrapping the stored Google/Microsoft OAuth tokens in Postgres.
#
# *** THE MOST CRITICAL VALUE IN THIS DEPLOYMENT ***
# If this changes and the old value is lost, every stored provider connection
# becomes permanently unreadable and all accounts must be reconnected by hand.
# Back it up with the Postgres volume — a database restore without the matching
# key produces an unusable credential store.
ENCRYPTION_KEY=change_me_to_random_key


########################### OAUTH PROVIDERS  (required for account connection)
# Must match the registered applications in Google Cloud Console and Azure Entra.
# Redirect URIs registered there must exactly match the callbacks Keeper expects
# at keeper-api.${DOMAINNAME}.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


########################### URLS AND ORIGINS  (required)
# Base domain — Traefik host rules are derived from it
DOMAINNAME=example.com

# Public WebSocket endpoint for real-time UI updates
WEBSOCKET_URL=wss://keeper-api.example.com/api/socket

# Public URL of the API, used when generating auth redirects
BETTER_AUTH_URL=https://keeper.example.com

# CSRF surface — set to exactly the origins the web UI runs on, nothing else.
# Comma-separated.
TRUSTED_ORIGINS=https://keeper.example.com


########################### MCP  (optional — omit to run without MCP)
# All three have working defaults in compose.yaml, so leaving them unset is safe:
# it disables MCP rather than breaking the stack. Set them only to override.
#
# Requires the cal-mcp service (keeper-mcp image, published from 2.19 onward).
# /mcp is proxied through cal-web, so it needs no Traefik route of its own.
#
#   MCP_PUBLIC_URL  public identity of the MCP resource. Setting this on cal-api
#                   is what ENABLES the OAuth authorisation server — without it
#                   the consent flow cannot complete even with cal-mcp running.
#   MCP_API_URL     internal API URL, for tool calls and MCP token signing keys
#   VITE_MCP_URL    internal proxy target cal-web uses for /mcp. Unset means /mcp
#                   falls through to the SPA router and 307s to /login.
#
# MCP_PUBLIC_URL=https://keeper.example.com/mcp
# MCP_API_URL=http://cal-api:3001
# VITE_MCP_URL=http://cal-mcp:3002
