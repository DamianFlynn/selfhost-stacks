# TREK Stack Environment Variables
# Copy to .env and set actual values:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not.

########################### LOCALE
TZ=Europe/Dublin

# info = concise user actions; debug = verbose admin-level detail
LOG_LEVEL=info


########################### CORE SECRET  (required)
# Symmetric key wrapping TREK's stored secrets at rest.
#
# Generate with:
#   openssl rand -hex 32
#
# *** BACK THIS UP ALONGSIDE THE VOLUMES ***
# If it is lost or changed, everything it wrapped becomes permanently
# unreadable. Leaving it unset makes TREK auto-generate a key on first boot,
# which then lives only inside the container volume - set it explicitly.
ENCRYPTION_KEY=change_me_openssl_rand_hex_32


########################### OPTIONAL
# Public base URL. Recommended for e-mail links; otherwise TREK falls back to
# the first ALLOWED_ORIGINS entry. Required if OIDC single sign-on is enabled.
APP_URL=https://trek.deercrest.info

# Outbound e-mail (SMTP). Needed for invite, reminder and password-reset e-mail.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Leave SMTP_SKIP_TLS_VERIFY
# unset unless you control the relay and it uses a self-signed certificate.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=TREK <noreply@deercrest.info>
# SMTP_SKIP_TLS_VERIFY=false

# Unsplash Access Key for trip-cover / place-image search. Without one, TREK
# uses the unauthenticated endpoint, which some datacenter IPs are blocked from.
# UNSPLASH_ACCESS_KEY=
