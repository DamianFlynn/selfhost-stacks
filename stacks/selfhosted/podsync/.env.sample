# Podsync Stack Environment Variables
# Copy to .env and fill in:  cp .env.sample .env
#
# This repository is PUBLIC. Never commit real values - .env is gitignored
# (**/.env), .env.sample is not. This stack has no secrets in .env: the YouTube API key
# lives in /mnt/fast/appdata/hoarder/podsync/config.toml (mounted read-only), see README.md.

########################### RUNTIME
# compose.yaml runs the container as user 568:568 directly.
PUID=568
PGID=568
TZ=Europe/Dublin

########################### ROUTING
# Router host is literal in compose.yaml: Host(`podsync.deercrest.info`), no Authelia chain
# (podcast clients fetch the feeds unauthenticated).
DOMAINNAME=deercrest.info
