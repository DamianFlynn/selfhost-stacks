# Monitoring Stack Environment Configuration
# Copy this file to .env and customize for your environment

# User/Group IDs (match your apps user)
PUID=568
PGID=568

# Timezone
TZ=Europe/Dublin

# Domain name for Traefik routing
DOMAINNAME=deercrest.info

# Appdata directory path
APPDATA_DIR=/mnt/fast/appdata

# Prometheus Configuration
# Retention period for metrics (default: 30 days)
PROMETHEUS_RETENTION=30d

# Grafana Configuration
# Default admin credentials (CHANGE THESE!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional Grafana plugins (comma-separated)
# Example: grafana-piechart-panel,grafana-clock-panel
GRAFANA_PLUGINS=

# Telegram alert delivery (image drift, unhealthy/created containers, and the staleness rule)
#
# ⚠️ THIS REPOSITORY IS PUBLIC (D-04). These two lines are a TEMPLATE and must stay EMPTY here.
#    The real values belong in .env (gitignored) beside this file, copied from ~/.claude/secrets/.
#    A gateway password sat in this repo for ~6 months and is still recoverable via `git log -S` —
#    redaction is not rotation.
#
# The bot does not exist yet. To create it:
#   1. Telegram -> @BotFather -> /newbot -> copy the HTTP API token
#   2. Send the new bot one message (bots CANNOT initiate a conversation, so the chat does not
#      exist until you do)
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
#   4. Store BOTH in ~/.claude/secrets/, then put them in .env here
#
# Left empty, Grafana still starts and the contact point still provisions — but every alert is
# delivered NOWHERE. See ../../../stacks/selfhosted/monitoring/README.md § Image drift detection,
# gated step G4: until a test message has actually arrived, this is not coverage.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
