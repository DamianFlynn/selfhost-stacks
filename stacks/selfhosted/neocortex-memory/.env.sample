# neocortex-memory Stack Environment Variables
# Copy to .env and fill in:  cp .env.sample .env   (README step 4 builds it from the provision run)
#
# THIS REPOSITORY IS PUBLIC. Never commit real values - .env is gitignored (**/.env),
# .env.sample is not. Nothing below is a hostname-to-token mapping, a hash, or a credential:
# these are NAMES ONLY, and it must stay that way.

########################### ROUTING
# Traefik router Host(`cortex.${DOMAINNAME}`) -> https://cortex.deercrest.info
DOMAINNAME=deercrest.info

########################### RUNTIME
# apps:apps on TrueNAS SCALE, the estate default. setup-neocortex-memory.sh prepare creates every
# directory under /mnt/fast/appdata/automation/neocortex-memory owned by this uid/gid.
PUID=568
PGID=568
TZ=Europe/Dublin

########################### THE TWO STORES
# Both point at the SAME Postgres server (agentic-os-db on the agentic-os_default network) and at
# two different databases, with two different roles. The split is the whole security model, so do
# not simplify it to one DSN.
#
# 1. The service's own database. Role `memory_api` OWNS neocortex_memory and has NO privilege on
#    any agentic_os object. Password generated on LXC 100 by `setup-neocortex-memory.sh provision`
#    and written only here.
MEMORY_DATABASE_URL=postgres://memory_api:<generated>@agentic-os-db:5432/neocortex_memory

# 2. The legacy bridge (TODO-311) - v1 recall, kept working until Phase 4 moves the content.
#    Role `memory_legacy_ro` holds USAGE on schema public and SELECT on exactly the tables the
#    search reads in agentic_os, and nothing in neocortex_memory. It never writes: no migrations,
#    no search_events, no DDL.
#
#    LEAVE BOTH OF THESE EMPTY TO TURN THE BRIDGE OFF. Setting only one is a start-up error that
#    names which half is missing - deliberately, because a half-configured bridge that silently
#    stayed off would look identical to one that is working and finding nothing.
MEMORY_LEGACY_DATABASE_URL=postgres://memory_legacy_ro:<generated>@agentic-os-db:5432/agentic_os
# The ONE identity the bridge answers for. Must be the users.id printed by `add-user damian`, and
# that user must hold capability `admin` in MEMORY_API_TOKENS below - loadTokenAuth refuses to
# start otherwise. Not Damian's v1 private id; that is --private-id at add-user time.
MEMORY_LEGACY_BRIDGE_USER_ID=

########################### AUTHENTICATION  (required - the server refuses to start without it)
# Comma-separated <users.id>:<capability>:<sha256-of-token>, one per client.
# Capabilities: member | indexer | admin.
#
# ONLY THE HASH GOES HERE. `memory-admin mint-token` prints the bearer token exactly once and
# prints this line ready to paste; the token itself goes to the client's token file
# (NEOCORTEX_MEMORY_TOKEN_FILE, mode 0600) and nowhere else. It is not recoverable - a lost token
# is re-minted, never looked up.
#
# Example shape only, not a real value:
#   MEMORY_API_TOKENS=00000000-0000-0000-0000-000000000000:admin:0000...0000
MEMORY_API_TOKENS=

########################### CONTROL PLANE  (exported per-shell, not usually stored here)
# Every memory-admin command after the first admin exists needs an explicit actor. README step 5
# exports it in the shell instead; it is listed here so `docker compose config` does not warn.
# MEMORY_ADMIN_ACTOR_USER_ID=
