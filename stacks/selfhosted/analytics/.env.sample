# Analytics Stack (Rybbit) - environment
# Copy to .env ON LXC 100 and replace every CHANGE_ME value. Never commit .env.

BASE_URL=https://pulse.deercrest.info

# Secrets: generate host-side with openssl rand -hex 32; never on the workstation.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
CLICKHOUSE_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

CLICKHOUSE_DB=analytics
POSTGRES_USER=rybbit
POSTGRES_DB=analytics

# Flip to true after the first (admin) account exists - D-05, then recreate rybbit-backend and
# rybbit-client.
DISABLE_SIGNUP=false

DISABLE_TELEMETRY=true
CLUSTER_WORKERS=1

# Optional: Mapbox token for the globe view.
MAPBOX_TOKEN=
