<?xml version="1.0"?>
<!-- Derived from upstream v2.9.3 docker-compose.yml configs: clickhouse_user_settings.
     Profile (user-level) settings are only read from users.d, not config.d. -->
<clickhouse>
    <profiles>
        <default>
            <enable_json_type>1</enable_json_type>
            <!-- Combine concurrent inserts into larger blocks inside ClickHouse. Wait for the flush
                 so the backend still receives insert errors. -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
            <log_processors_profiles>0</log_processors_profiles>
            <!-- Upstream ships 32 GB and 16 threads, sized for a large host. Under a 1 GiB server cap
                 that is meaningless: one query may use at most 512 MiB, with 2 threads. -->
            <max_memory_usage>536870912</max_memory_usage>
            <max_threads>2</max_threads>
        </default>
    </profiles>
</clickhouse>
