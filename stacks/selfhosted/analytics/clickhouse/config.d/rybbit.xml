<?xml version="1.0"?>
<!-- Derived from upstream v2.9.3 docker-compose.yml configs: clickhouse_network/logging/resource_limits,
     merged into one file and tightened for a memory-capped container (mem_limit 1536m). -->
<clickhouse>
    <!-- clickhouse_network -->
    <listen_host>0.0.0.0</listen_host>

    <!-- clickhouse_logging: quiet logger, and drop the system log tables (they grow without bound
         and cost memory on a small host). -->
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <query_thread_log remove="remove"/>
    <query_log remove="remove"/>
    <query_views_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <error_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <text_log remove="remove"/>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <part_log remove="remove"/>
    <latency_log remove="remove"/>
    <processors_profile_log remove="remove"/>

    <!-- clickhouse_resource_limits (upstream values) -->
    <max_server_memory_usage_to_ram_ratio>0.80</max_server_memory_usage_to_ram_ratio>
    <concurrent_threads_soft_limit_ratio_to_cores>1</concurrent_threads_soft_limit_ratio_to_cores>
    <merges_mutations_memory_usage_to_ram_ratio>0.25</merges_mutations_memory_usage_to_ram_ratio>

    <!-- Our tightening. An absolute 1 GiB server cap, under the 1536m container limit, leaving
         headroom for the process itself. The ratio above is computed against the host's RAM, which
         ClickHouse may read as the whole LXC rather than the cgroup limit, so the absolute value is
         what holds. -->
    <max_server_memory_usage>1073741824</max_server_memory_usage>
    <!-- 256 MiB; the default mark cache is GiB-scale. -->
    <mark_cache_size>268435456</mark_cache_size>
</clickhouse>
